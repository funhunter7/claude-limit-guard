{
  "UserPromptSubmit": [
    {
      "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/usage.mjs\" --context", "timeout": 10 }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/usage.mjs\" --stop", "timeout": 10 }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/usage.mjs\" --resume-check", "timeout": 10 }
      ]
    }
  ]
}
